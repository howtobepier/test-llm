LLM_PROVIDER=ollama
# Modello più piccolo = risposte più veloci (pull: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b
# Opzionale se Ollama non è su localhost:
# OLLAMA_BASE_URL=http://localhost:11434
# Prestazioni generazione (opzionali):
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.7
