LLM_PROVIDER=ollama
# Modello locale consigliato su CPU / ~16GB RAM (recuperabile: llama3.1:latest)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.4
OLLAMA_TIMEOUT_S=90
OLLAMA_PRELOAD=true

HISTORY_MAX_MESSAGES=6
MEMORY_BUDGET_CHARS=1200
LLM_QUEUE_SIZE=1

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

VOICE_STT_ENABLED=true
VOICE_STT_MODEL=tiny
VOICE_TTS_ENABLED=true
VOICE_MAX_SECONDS=30
VOICE_KEEP_AUDIO=false

QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
